# Ta'meer-e-Rekhta Management Portal & Unified Website Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Secrets (Generate strong random strings for production)
JWT_SECRET=rekhta_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=rekhta_refresh_super_secret_2026

# Nodemailer / SMTP Email Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ta'meer-e-Rekhta" <no-reply@rekhta.org>
VOLUNTEER_RECIPIENT_EMAIL=taameer.e.rekhta@gmail.com

# Google Sheets Webhook Sync URL (Apps Script)
GOOGLE_SHEETS_WEBHOOK_URL=

# Google Drive Integration (Service Account / OAuth)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
