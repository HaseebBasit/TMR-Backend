# ==============================================================================
# TA'MEER-E-REKHTA MANAGEMENT PORTAL — BACKEND STAGING CONFIGURATION TEMPLATE
# Environment: staging
# Strict Rule: Staging MONGODB_URI MUST target "tameer_rekhta_staging".
# Connecting to "tameer_rekhta" (production) is strictly blocked by db.js.
# ==============================================================================
PORT=5001
NODE_ENV=staging
FRONTEND_URL=http://localhost:3001

# Isolated Staging Database (Must NEVER be tameer_rekhta)
# Format: mongodb+srv://<staging_user>:<staging_password>@<staging_cluster>.mongodb.net/tameer_rekhta_staging?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://staging_user:staging_password@staging-cluster.mongodb.net/tameer_rekhta_staging?retryWrites=true&w=majority

# Independent Staging JWT Secrets (Generate: node scripts/generate-secrets.js)
# Minimum 32 characters (256-bit entropy). Must be distinct from production keys.
JWT_SECRET=generate_with_scripts_generate_secrets_js_min_32_chars_for_staging
JWT_REFRESH_SECRET=generate_with_scripts_generate_secrets_js_min_32_chars_for_staging

# Safe Staging Email Sink Configuration
# Setting EMAIL_DISABLED=true guarantees zero outbound SMTP email transmission
EMAIL_DISABLED=true
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=mock_staging_user
SMTP_PASS=mock_staging_pass
SMTP_FROM="Ta'meer-e-Rekhta Staging" <staging-no-reply@rekhta.internal>
VOLUNTEER_RECIPIENT_EMAIL=staging-volunteer@rekhta.internal

# Staging Rate Limiting Overrides (Optional)
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_RESET_MAX=10

# Mock Integration Hooks (Do NOT point to production Google Drive or Sheets)
GOOGLE_SHEETS_WEBHOOK_URL=http://localhost:5001/api/mock/webhook
GOOGLE_SERVICE_ACCOUNT_EMAIL=mock-service@staging.internal
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=mock_private_key
GOOGLE_DRIVE_FOLDER_ID=mock_staging_folder_id
